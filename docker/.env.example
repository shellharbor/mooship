# Copy to docker/.env and supply separate secret files in .secrets/.
MOODLE_DB_TYPE=pgsql
MOODLE_WWWROOT=http://localhost:8080
MOODLE_ADMIN_EMAIL=admin@example.org
MOODLE_SITE_FULLNAME=Mooship Moodle
MOODLE_SITE_SHORTNAME=Mooship
MOOSHIP_BIND_ADDRESS=127.0.0.1
MOOSHIP_HTTP_PORT=8080
# For TLS termination at a trusted reverse proxy, use an HTTPS WWWROOT
# and set MOODLE_SSL_PROXY=true. See docs/DOCKER.md before enabling proxy flags.
