# Example /var/www/<slug>/.env generated by deploy-moodle.sh
# (slug=lms, container PostgreSQL). All values are fake.
# This header is absent from the real file, which starts with SITE_HOST.
# AUTH_* is included only with --enable-basic-auth,
# MOODLE_ADMIN_* is appended only after successful CLI installation,
# BACKUP_ARCHIVE_PATH is included only with --create-backup.
# MySQL uses DB_MYSQL_NAME, DB_MYSQL_USER instead of DB_POSTGRES_*,
# DB_MYSQL_PASSWORD, DB_MYSQL_PASSWORD_ROOT.
SITE_HOST=lms.example.com
SITE_SCHEME=https
SITE_PORT_HTTP=8247
SITE_PORT_HTTPS=4189

PHP_PORT=9347

REDIS_PORT=6612
REDIS_PASSWORD=ChangeMe_Redis1

DB_PORT=5623
DB_POSTGRES_NAME=k7x2m9q4p5w8z3a
DB_POSTGRES_USER=n6v8c2b4m9k7p3r
DB_POSTGRES_PASSWORD=ChangeMe_Pg_001

DB_NATIVE=false
PHP_VERSION=83
MOODLE_VERSION=4.5.0

AUTH_USER=reviewer
AUTH_PASSWORD=ChangeMe_Basic1

# Moodle Administrator Credentials
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=ChangeMe_Adm_01
MOODLE_ADMIN_EMAIL=admin@lms.example.com

# Backup Archive
BACKUP_ARCHIVE_PATH=/var/backups/mooship/lms_20260927_101500.tar.gz
